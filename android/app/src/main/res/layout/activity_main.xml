<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A237E"
    android:padding="24dp">

    <!-- App title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Field Investigation"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
        android:layout_marginTop="48dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Credit Verification System"
        android:textColor="#90CAF9"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardSteps"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp" />

    <!-- Steps card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSteps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#283593"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnStartFi"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How it works"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView android:id="@+id/step1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="1.  Questions will be asked verbally — answer by speaking clearly"
                android:textColor="#E3F2FD" android:textSize="14sp" android:layout_marginBottom="12dp" />

            <TextView android:id="@+id/step2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="2.  Your answer is transcribed and shown on screen"
                android:textColor="#E3F2FD" android:textSize="14sp" android:layout_marginBottom="12dp" />

            <TextView android:id="@+id/step3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="3.  Photos of the applicant and property will be captured automatically"
                android:textColor="#E3F2FD" android:textSize="14sp" android:layout_marginBottom="12dp" />

            <TextView android:id="@+id/step4"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="4.  The session is recorded throughout"
                android:textColor="#E3F2FD" android:textSize="14sp" android:layout_marginBottom="12dp" />

            <TextView android:id="@+id/step5"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="5.  Tap Submit when done — report is generated automatically"
                android:textColor="#E3F2FD" android:textSize="14sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Start button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartFi"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Start Field Investigation"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="#E53935"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
